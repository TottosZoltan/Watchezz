rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string && request.resource.data.t.size() <= 150
        && request.resource.data.x is string && request.resource.data.x.size() <= 5000
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /likes/{rid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
