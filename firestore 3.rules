rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }

    // Az admin fiókot az első admin@admin.com regisztráló "foglalja le", utána nem módosítható
    match /config/admin {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email == 'admin@admin.com'
        && !exists(/databases/$(database)/documents/config/admin)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/announcement {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string && request.resource.data.t.size() <= 150
        && request.resource.data.x is string && request.resource.data.x.size() <= 5000
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5;
      // csak az admin módosíthat, és csak a kiemelést (pin)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin']);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /stories/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string && request.resource.data.t.size() <= 150
        && request.resource.data.x is string && request.resource.data.x.size() <= 140
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5;
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // nyilvános profil: név + kis profilkép (data URL, max ~70 KB)
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (!('photo' in request.resource.data) || request.resource.data.photo.size() < 70000);
    }

    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /likes/{rid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
